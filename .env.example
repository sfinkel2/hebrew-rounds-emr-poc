# Copy this file to .env and (optionally) fill in your API keys.
#
# Leave the keys blank to run in deterministic MOCK mode (no network, fully
# offline) — the recommended classroom-demo fallback. With keys present, the
# app uses the LIVE OpenAI Whisper (Hebrew STT) + Anthropic Claude path.
#
# Set DEMO_MODE=mock to FORCE mock mode even when keys are present.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEMO_MODE=
